{
  "family": "legal-doc-analyzer",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "PLACEHOLDER_EXECUTION_ROLE_ARN",
  "taskRoleArn": "PLACEHOLDER_TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "legal-doc-analyzer",
      "image": "PLACEHOLDER_IMAGE_URI",
      "portMappings": [
        {
          "containerPort": 8501,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "AWS_REGION", "value": "PLACEHOLDER_REGION" },
        { "name": "BEDROCK_AGENT_ID", "value": "PLACEHOLDER_AGENT_ID" },
        { "name": "BEDROCK_AGENT_ALIAS_ID", "value": "PLACEHOLDER_AGENT_ALIAS_ID" },
        { "name": "CHUNK_MAX_SIZE", "value": "8000" },
        { "name": "CHUNK_MIN_SIZE", "value": "500" },
        { "name": "COGNITO_POOL_ID", "value": "PLACEHOLDER_COGNITO_POOL_ID" },
        { "name": "COGNITO_APP_CLIENT_ID", "value": "PLACEHOLDER_COGNITO_CLIENT_ID" },
        { "name": "COGNITO_APP_CLIENT_SECRET", "value": "PLACEHOLDER_COGNITO_CLIENT_SECRET" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/legal-doc-analyzer",
          "awslogs-region": "PLACEHOLDER_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8501/_stcore/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
