{
  "family": "legal-doc-analyzer",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::015337708931:role/ecsTaskExecutionRole-north",
  "taskRoleArn": "arn:aws:iam::015337708931:role/ecsTaskRole-north",
  "containerDefinitions": [
    {
      "name": "legal-doc-analyzer",
      "image": "015337708931.dkr.ecr.eu-north-1.amazonaws.com/legal-doc-analyzer:latest",
      "portMappings": [
        {
          "containerPort": 8501,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "AWS_REGION", "value": "eu-north-1" },
        { "name": "BEDROCK_AGENT_ID", "value": "674AROCWQL" },
        { "name": "BEDROCK_AGENT_ALIAS_ID", "value": "FGBKQ7SJ4I" },
        { "name": "CHUNK_MAX_SIZE", "value": "8000" },
        { "name": "CHUNK_MIN_SIZE", "value": "500" },
        { "name": "COGNITO_POOL_ID", "value": "eu-north-1_UpKKPYBeb" },
        { "name": "COGNITO_APP_CLIENT_ID", "value": "23hvvanb4ogkhjdoguqj5ctdjt" },
        { "name": "COGNITO_APP_CLIENT_SECRET", "value": "hf4saqfotu81foc5re2l4v9ckfgd453tmgc2lpbk06atl4bj0ql" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/legal-doc-analyzer",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8501/_stcore/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
