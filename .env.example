# AWS Region (picked up from aws configure if not set)
AWS_REGION=eu-north-1

# Bedrock Agent (from CloudFormation stack outputs)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# Cognito Authentication
COGNITO_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=

# Chunk Configuration (optional — defaults used if not set)
CHUNK_MAX_SIZE=8000
CHUNK_MIN_SIZE=500
CHUNK_CONTEXT_WINDOW=1500
CHUNK_OVERLAP=200
