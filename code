# ============================================================
# CloudAge Legal Document Analyzer — Deployment Guide
# Region is picked up from: aws configure get region
# ============================================================

# --- Prerequisites ---
# 1. AWS CLI configured: aws configure (set region to eu-north-1)
# 2. Docker installed (for local builds)
# 3. Python 3.13+

# --- STEP 1: Deploy Bedrock Agents ---

aws cloudformation create-stack \
  --stack-name AnalyzeDoc-bedrock-agents \
  --template-body file://LEGAL-Documents-Collab-Amazon-Model.yaml \
  --parameters \
    ParameterKey=EnvironmentName,ParameterValue=LegalDocSetup \
    ParameterKey=FoundationModelId,ParameterValue=eu.amazon.nova-pro-v1:0 \
  --capabilities CAPABILITY_IAM

# Wait and get outputs
aws cloudformation wait stack-create-complete --stack-name AnalyzeDoc-bedrock-agents
aws cloudformation describe-stacks --stack-name AnalyzeDoc-bedrock-agents --query 'Stacks[0].Outputs'


# --- STEP 2: Set environment variables from outputs ---

export AWS_REGION=$(aws configure get region)
export BEDROCK_AGENT_ID=$(aws cloudformation describe-stacks --stack-name AnalyzeDoc-bedrock-agents \
  --query 'Stacks[0].Outputs[?OutputKey==`CollabBedrockAgentId`].OutputValue' --output text)
export BEDROCK_AGENT_ALIAS_ID=$(aws cloudformation describe-stacks --stack-name AnalyzeDoc-bedrock-agents \
  --query 'Stacks[0].Outputs[?OutputKey==`CollabBedrockAgentAliasId`].OutputValue' --output text)

echo "Region: $AWS_REGION"
echo "Agent ID: $BEDROCK_AGENT_ID"
echo "Agent Alias ID: $BEDROCK_AGENT_ALIAS_ID"


# --- STEP 3: Run locally ---

pip install -r requirements.txt
streamlit run Analyze-LegalDocumentsUI.py


# --- STEP 4 (Optional): Docker ---

docker build -t legal-doc-analyzer .
docker run -p 8501:8501 \
  -e AWS_REGION=$AWS_REGION \
  -e BEDROCK_AGENT_ID=$BEDROCK_AGENT_ID \
  -e BEDROCK_AGENT_ALIAS_ID=$BEDROCK_AGENT_ALIAS_ID \
  -e COGNITO_POOL_ID=$COGNITO_POOL_ID \
  -e COGNITO_APP_CLIENT_ID=$COGNITO_APP_CLIENT_ID \
  -e COGNITO_APP_CLIENT_SECRET=$COGNITO_APP_CLIENT_SECRET \
  -e AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID \
  -e AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY \
  legal-doc-analyzer


# --- STEP 5 (Optional): Full CI/CD Pipeline ---

# Create CodeCommit repo
aws codecommit create-repository --repository-name legal-doc-analyzer

# Push code
git remote add origin https://git-codecommit.$(aws configure get region).amazonaws.com/v1/repos/legal-doc-analyzer
git push -u origin main

# Create ECR repo
aws ecr create-repository --repository-name legal-doc-analyzer --image-scanning-configuration scanOnPush=true

# Create CodeBuild project (uses buildspec.yml, picks up region automatically)
aws codebuild create-project \
  --name legal-doc-analyzer-build \
  --source type=CODECOMMIT,location=https://git-codecommit.$(aws configure get region).amazonaws.com/v1/repos/legal-doc-analyzer,buildspec=buildspec.yml \
  --source-version refs/heads/main \
  --artifacts type=NO_ARTIFACTS \
  --environment type=LINUX_CONTAINER,computeType=BUILD_GENERAL1_SMALL,image=aws/codebuild/standard:7.0,privilegedMode=true \
  --service-role <YOUR_CODEBUILD_ROLE_ARN>

# Trigger build
aws codebuild start-build --project-name legal-doc-analyzer-build


# --- STEP 6 (Optional): ECS Fargate + ALB ---

# Generate taskdef from template (replace placeholders)
REGION=$(aws configure get region)
ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)

sed -e "s|PLACEHOLDER_REGION|$REGION|g" \
    -e "s|PLACEHOLDER_IMAGE_URI|$ACCOUNT_ID.dkr.ecr.$REGION.amazonaws.com/legal-doc-analyzer:latest|g" \
    -e "s|PLACEHOLDER_EXECUTION_ROLE_ARN|arn:aws:iam::$ACCOUNT_ID:role/ecsTaskExecutionRole-north|g" \
    -e "s|PLACEHOLDER_TASK_ROLE_ARN|arn:aws:iam::$ACCOUNT_ID:role/ecsTaskRole-north|g" \
    -e "s|PLACEHOLDER_AGENT_ID|$BEDROCK_AGENT_ID|g" \
    -e "s|PLACEHOLDER_AGENT_ALIAS_ID|$BEDROCK_AGENT_ALIAS_ID|g" \
    -e "s|PLACEHOLDER_COGNITO_POOL_ID|$COGNITO_POOL_ID|g" \
    -e "s|PLACEHOLDER_COGNITO_CLIENT_ID|$COGNITO_APP_CLIENT_ID|g" \
    -e "s|PLACEHOLDER_COGNITO_CLIENT_SECRET|$COGNITO_APP_CLIENT_SECRET|g" \
    taskdef.json > taskdef-resolved.json

# Register task definition
aws ecs register-task-definition --cli-input-json file://taskdef-resolved.json

# Create cluster + service (see deploy.sh for full setup)
  source .venv/bin/activate
  python legal-mcp-server/server.py --http --port 8080

# 1. Initialize (get session)
curl -X POST http://localhost:8080/mcp \
  -H "Content-Type: application/json" \
  -H "Accept: application/json, text/event-stream" \
  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","clientInfo":{"name":"client","version":"1.0"},"capabilities":{}}}'

# 2. Call analyze_document (include Mcp-Session-Id from step 1 response headers)
curl -X POST http://localhost:8080/mcp \
  -H "Content-Type: application/json" \
  -H "Accept: application/json, text/event-stream" \
  -H "Mcp-Session-Id: <session-id>" \
  -d '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"analyze_document","arguments":{"document_text":"Your document text here..."}}}'

{
  "legal-doc-analyzer": {
    "url": "http://localhost:8080/mcp"
  }
}
