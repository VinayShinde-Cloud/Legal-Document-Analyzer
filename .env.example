# AWS Region (picked up from aws configure if not set)
AWS_REGION=eu-north-1

# Bedrock Supervisor Agent (from CloudFormation stack outputs)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# Individual Agent IDs (from CloudFormation stack outputs — used for direct calls)
CLASSIFICATION_AGENT_ID=
CLASSIFICATION_ALIAS_ID=
CONTRACT_AGENT_ID=
CONTRACT_ALIAS_ID=
EMAIL_AGENT_ID=
EMAIL_ALIAS_ID=
LEGAL_AGENT_ID=
LEGAL_ALIAS_ID=

# Cognito Authentication
COGNITO_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=

# Result Persistence (from batch pipeline CloudFormation stack outputs)
RESULTS_TABLE=
OUTPUT_BUCKET=

# Chunk Configuration (optional — defaults used if not set)
CHUNK_MAX_SIZE=8000
CHUNK_MIN_SIZE=500
CHUNK_CONTEXT_WINDOW=1500
CHUNK_OVERLAP=200
